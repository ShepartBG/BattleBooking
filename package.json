{
  "name": "battlebooking",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:browser": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=chromium",
    "test:browser:headed": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=chromium --headed",
    "test:browser:mobile": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=mobile",
    "test:browser:full": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test tests/full-flow.spec.ts --project=chromium",
    "test:browser:report": "playwright show-report",
    "test:browser:owner": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=owner",
    "test:browser:lifecycle": "node --env-file=.env.local --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=lifecycle",
    "test:browser:extended": "node --env-file=.env.local --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=extended",
    "test:browser:cross": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=firefox --project=webkit --project=webkit-iphone",
    "test:browser:all": "node --env-file=.env.test.local ./node_modules/@playwright/test/cli.js test --project=chromium --project=owner"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "next": "15.5.20",
    "react": "19.2.7",
    "react-datepicker": "9.1.0",
    "react-dom": "19.2.7",
    "styled-jsx": "5.1.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "20.19.26",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "@playwright/test": "latest"
  }
}
